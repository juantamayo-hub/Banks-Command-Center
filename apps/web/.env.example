# Nombres de variables (sin valores). Los valores reales van en .env.local / Vercel, nunca en el repo.

# Alma · regenerar dossier y buzón de hipotecas (n8n)
ALMA_N8N_DOSSIER_REGEN_URL=
ALMA_N8N_MAILBOX_URL=
ALMA_N8N_SECRET=
# Emails (separados por comas) con acceso al buzón; vacío = buzón desactivado
ALMA_MAILBOX_EMAILS=
