        }
      },
      "id": "read-rastreator",
      "name": "Leer Rastreator",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Map sheet rows to API payload\n// Columns: ID | DNI | Importe compraventa | Importe hipoteca | Ingresos 1T | Tipo contrato 1T | Ingresos 2T | Tipo contrato 2T | Respuesta Rastreator\n\nconst rows = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n\n  // Deal ID is in the 'ID' column\n  const dealIdRaw = row['ID'] || row['id'] || '';\n  const dealId = parseInt(String(dealIdRaw).trim(), 10);\n  if (!dealId || isNaN(dealId) || dealId <= 0) continue;\n\n  // 'Respuesta Rastreator' column (last column)\n  const respuesta = String(row['Respuesta Rastreator'] || '').trim();\n  if (!respuesta) continue;\n\n  let rastreatorStatus;\n  if (respuesta === 'Enviar') {\n    rastreatorStatus = 'approved';\n  } else if (respuesta === 'No enviar') {\n    rastreatorStatus = 'rejected';\n  } else {\n    // Any other value (blank handled above) → pending\n    continue;\n  }\n\n  // Row number is 1-based in sheet; header is row 1, so data starts at row 2\n  const rastreatorRow = i + 2; // i is 0-based index of data rows after header\n\n  rows.push({\n    deal_id: dealId,\n    rastreator_status: rastreatorStatus,\n    rastreator_row: rastreatorRow\n  });\n}\n\nif (rows.length === 0) {\n  // Return a no-op marker so downstream nodes don't fail\n  return [{ json: { rows: [], skipped: true } }];\n}\n\nreturn [{ json: { rows } }];"
      },
      "id": "map-rows",
      "name": "Mapear filas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
