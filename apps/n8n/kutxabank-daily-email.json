{
  "name": "Kutxabank - Daily Email (13:00 & 17:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "0 17 * * 1-5"
            }
          ]
        },
        "timezone": "Europe/Madrid"
      },
      "id": "schedule-trigger",
      "name": "Schedule (13:00 & 17:00 Mon-Fri)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $env.KUTXABANK_SHEET_ID }}",
          "mode": "id"
        },
        "options": {
          "fileName": "=Kutxabank_{{ $now.format('yyyy-MM-dd_HHmm') }}.xlsx",
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            }
          }
        }
      },
      "id": "download-sheet",
      "name": "Descargar Sheet como XLSX",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [240, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Juanjo Google Drive"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "juan.tamayo@huspy.io",
        "subject": "=Kutxabank diario — {{ $now.setZone('Europe/Madrid').toFormat('d/M/yyyy HH:mm') }}",
        "message": "Adjunto el Excel con las tabs '1 Filtro' y 'Ops. Enviadas' del día.",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          },
          "appendAttribution": false
        }
      },
      "id": "send-email",
      "name": "Send Email con adjunto",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail"
        }
      }
    }
  ],
  "connections": {
    "Schedule (13:00 & 17:00 Mon-Fri)": {
      "main": [
        [
          { "node": "Descargar Sheet como XLSX", "type": "main", "index": 0 }
        ]
      ]
    },
    "Descargar Sheet como XLSX": {
      "main": [
        [
          { "node": "Send Email con adjunto", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid"
  },
  "meta": {
    "instanceId": "kutxabank-daily-email"
  }
}
