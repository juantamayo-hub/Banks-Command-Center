      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  if (item.binary?.data) {\n    item.binary.data.fileName = `Kutxabank_${$now.setZone(\"Europe/Madrid\").toFormat(\"yyyy-MM-dd_HHmm\")}.xlsx`;\n    item.binary.data.mimeType = \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\";\n  }\n}\nreturn items;"
      },
